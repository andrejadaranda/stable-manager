# Copy this file to .env.local and fill in real values from your Supabase project.
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by Stripe webhook / admin scripts.
# NEVER expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used as a fallback for emailRedirectTo when no Host
# header is available (e.g. background jobs). The signup action prefers
# the live request host, so dev/preview/prod all "just work" without
# changing this. Keep it pointing at the canonical prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used for transactional email (waitlist welcome, etc.).
# The same API key is also pasted into Supabase Dashboard → Auth → SMTP
# so confirmation emails route through Resend. See docs/AUTH-SETUP.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@longrein.eu
RESEND_FROM_NAME=Longrein

# ---------------- Stripe ----------------
# REQUIRED before public launch (M6, November 2026). Founding-member
# launch (May 23 2026) ships without these — FMs are on 12-month free
# SaaS and never enter a Stripe checkout flow.
#
# Wiring (see app/api/stripe/webhook/route.ts header comment):
#   1. Create products + prices in Stripe Dashboard (one per tier).
#   2. Add webhook endpoint → /api/stripe/webhook ; copy signing secret.
#   3. Apply migration 36_billing_schema_consolidation.sql to the DB.
#   4. Verify webhook with `stripe trigger checkout.session.completed`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# ------------- Personal command centre (/personal) -------------
# EVERY variable in this block is OPTIONAL, and every one of them can
# instead be set from the Settings screen at /personal/nustatymai, which
# writes to dashboard_integration_settings.
#
# The stored value WINS over the environment variable. That ordering is
# deliberate: a Vercel env var needs a laptop and a redeploy, whereas a
# token she can rotate from her phone is the difference between an
# integration that keeps working and one that dies the first time Meta
# expires a token. See services/personalDashboard/settings.ts.
#
# Nothing here is required for the dashboard to load — every screen has an
# honest empty state.

# Claude, for the "what should I do today" advisor.
ANTHROPIC_API_KEY=

# Shared secret the tjk-daily-inbox-check job authenticates with when it
# POSTs the morning briefing to /api/personal/briefing. No secret set
# anywhere => that endpoint 404s, as if it did not exist.
PERSONAL_BRIEFING_SECRET=

# Meta Graph API — Instagram Business + Facebook Page metrics.
# Token click path is documented in docs/PERSONAL-DASHBOARD.md § 3.4.
# Long-lived tokens expire after ~60 days and must be re-pasted.
META_IG_USER_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_PAGE_ID=
META_FB_PAGE_ACCESS_TOKEN=

# tjk.lt WordPress REST base. Defaults to https://tjk.lt; only set this if
# the site moves. No credentials needed — wp-json is public.
PERSONAL_WEBSITE_URL=

# Web Push. Leave blank: lib/personal/push.ts generates a VAPID keypair on
# first subscribe and stores it. Set these only to pin a specific pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Protects the daily push cron. When unset, the route falls back to
# accepting Vercel's own x-vercel-cron header so the job works from the
# first deploy. Setting it tightens the check.
CRON_SECRET=
